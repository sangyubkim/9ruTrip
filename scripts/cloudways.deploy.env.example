# Copy to cloudways.deploy.env (gitignored) and fill in values.
# Do not commit real host/passwords.

CLOUDWAYS_HOST=YOUR_PUBLIC_IP_OR_HOSTNAME
CLOUDWAYS_USER=master
CLOUDWAYS_REMOTE_BIN=~/bin

# Optional OpenSSH private key (PEM). Leave empty to use ssh-agent / password prompt.
# CLOUDWAYS_KEY_PATH=C:\Users\YOU\.ssh\id_ed25519
